{
  "name": "workshop-coding-assistants (OpenCode Server)",
  "image": "mcr.microsoft.com/devcontainers/java:21-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "21"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}",
    "GROQ_API_KEY": "${localEnv:GROQ_API_KEY}",
    "OPENCODE_HOSTNAME": "0.0.0.0",
    "OPENCODE_PORT": "4096"
  },
  "forwardPorts": [4096, 8080, 5173, 5432],
  "portsAttributes": {
    "4096": {
      "label": "OpenCode Server",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "8080": {
      "label": "Customer Manager Server"
    },
    "5173": {
      "label": "Customer Manager Client (Vite)"
    },
    "5432": {
      "label": "PostgreSQL"
    }
  },
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "pivotal.vscode-boot-dev-pack",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "MS-vsliveshare.vsliveshare"
      ]
    }
  },
  "remoteUser": "vscode"
}
