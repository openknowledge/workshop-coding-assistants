# Self-hosted OpenCode server.
# Provides Java 21 + Node 21 + OpenCode CLI and runs `opencode serve` so the
# server can be reached by HTTP clients (browser, CLI, IDE plugin) over the
# network. Pair with docker-compose.opencode.yaml.

FROM eclipse-temurin:21-jdk-jammy

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_MAJOR=21 \
    OPENCODE_HOSTNAME=0.0.0.0 \
    OPENCODE_PORT=4096 \
    PATH="/root/.opencode/bin:${PATH}"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      curl ca-certificates gnupg git bash unzip \
 && mkdir -p /etc/apt/keyrings \
 && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# Install OpenCode via the official installer.
RUN curl -fsSL https://opencode.ai/install | bash \
 && /root/.opencode/bin/opencode --version

WORKDIR /workspace

EXPOSE 4096

# `opencode serve` reads ANTHROPIC_API_KEY / OPENAI_API_KEY / OPENROUTER_API_KEY
# / GROQ_API_KEY from the environment if set; otherwise an interactive
# `opencode auth login` from inside the container is required (mount a
# persistent volume on /root/.local/share/opencode to keep the credentials).
ENTRYPOINT ["/bin/sh", "-c", "exec opencode serve --hostname \"$OPENCODE_HOSTNAME\" --port \"$OPENCODE_PORT\""]
